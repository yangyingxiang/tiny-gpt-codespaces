{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train: quick debug run (300 iters)",
      "type": "debugpy",
      "request": "launch",
      "module": "sft.train",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": [
        "--max_iters", "300",
        "--eval_interval", "100",
        "--eval_examples", "50",
        "--final_eval_examples", "100",
        "--log_interval", "20"
      ]
    },
    {
      "name": "Train: full run (3000 iters, ~2-3 min)",
      "type": "debugpy",
      "request": "launch",
      "module": "sft.train",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": []
    },
    {
      "name": "Evaluate checkpoint (val + holdout exact match)",
      "type": "debugpy",
      "request": "launch",
      "module": "sft.evaluate",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": ["--ckpt", "checkpoints/model.pt"]
    },
    {
      "name": "Generate: ask the checkpoint",
      "type": "debugpy",
      "request": "launch",
      "module": "sft.generate",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": ["--instruction", "Reverse:", "--input", "banana"]
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": ["-vv", "tests"]
    },
    {
      "name": "Pytest: parser spec only (Part 1)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "args": ["-vv", "tests/test_parser.py"]
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Attach to running process (debugpy :5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "justMyCode": false,
      "pathMappings": [
        { "localRoot": "${workspaceFolder}", "remoteRoot": "." }
      ]
    }
  ]
}
