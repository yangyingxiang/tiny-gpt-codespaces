{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install deps",
      "type": "shell",
      "command": "python -m pip install --index-url https://download.pytorch.org/whl/cpu torch && python -m pip install numpy pytest",
      "problemMatcher": []
    },
    {
      "label": "prepare data",
      "type": "shell",
      "command": "python scripts/prepare_data.py",
      "problemMatcher": []
    },
    {
      "label": "train (quick)",
      "type": "shell",
      "command": "python -m src.train --max_iters 100 --log_interval 10",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "python -m pytest -q tests",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "debug server (attach on :5678)",
      "type": "shell",
      "command": "python -m debugpy --listen 5678 --wait-for-client -m src.train --max_iters 50",
      "problemMatcher": []
    }
  ]
}
