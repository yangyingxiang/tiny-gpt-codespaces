{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install deps",
      "type": "shell",
      "command": "python -m pip install --index-url https://download.pytorch.org/whl/cpu torch && python -m pip install numpy pytest",
      "problemMatcher": []
    },
    {
      "label": "train (quick, 300 iters)",
      "type": "shell",
      "command": "python -m sft.train --max_iters 300 --eval_interval 100 --eval_examples 50 --final_eval_examples 100",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "train (full)",
      "type": "shell",
      "command": "python -m sft.train",
      "problemMatcher": []
    },
    {
      "label": "evaluate checkpoint",
      "type": "shell",
      "command": "python -m sft.evaluate",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "python -m pytest -q tests",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test parser spec (Part 1)",
      "type": "shell",
      "command": "python -m pytest -q tests/test_parser.py",
      "problemMatcher": []
    },
    {
      "label": "debug server (attach on :5678)",
      "type": "shell",
      "command": "python -m debugpy --listen 5678 --wait-for-client -m sft.train --max_iters 300",
      "problemMatcher": []
    }
  ]
}
